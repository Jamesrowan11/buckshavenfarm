# Bucks Haven Farm — environment variables
#
# On Plesk, enter these in Websites & Domains → Node.js → "Custom environment
# variables" (or put them in a .env.production file in the application root
# that is NOT committed). Placeholder values only — never commit real secrets.
# None of these may start with NEXT_PUBLIC_: that would expose them to browsers.

# ---- Database (MySQL 8.0+ / MariaDB 10.5+ created in Plesk) ----
# Either one connection URL (URL-encode special characters in the password):
# DATABASE_URL=mysql://bhf_app:CHANGE_ME@localhost:3306/bhf_portal
# ...or separate variables (these override the matching part of DATABASE_URL):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bhf_portal
DB_USER=bhf_app
DB_PASSWORD=CHANGE_ME
# DB_SOCKET=/var/run/mysqld/mysqld.sock   # optional: connect via unix socket
# DB_SSL=false                            # true if the DB server requires TLS
# DB_POOL_SIZE=10

# ---- Application ----
NODE_ENV=production
# Farm-local time zone for "today", schedules and displayed times.
APP_TIME_ZONE=America/New_York

# ---- Sessions / security ----
# Idle timeout and absolute lifetime of a sign-in, in hours.
SESSION_IDLE_HOURS=168
SESSION_MAX_HOURS=720
# Cookies are marked Secure (HTTPS only) in production. Only set this to
# false for a temporary plain-HTTP test site.
# COOKIE_SECURE=true
# Extra hostnames the site is served from, if more than one (comma-separated).
# ALLOWED_ORIGINS=portal.example.com,www.portal.example.com

# ---- Only when not running under Plesk/Passenger (e.g. `node server.js`) ----
# PORT=3000
# HOST=127.0.0.1
