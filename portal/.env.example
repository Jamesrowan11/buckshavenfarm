# Copy to .env and fill in. Never commit .env.
# MariaDB/MySQL connection (create the DB + user in Plesk → Databases)
DATABASE_URL="mysql://bhf_portal:CHANGE_ME@localhost:3306/bhf_portal"

# Long random string — sign-in cookies are signed with this.
# Generate one:  openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Where uploaded documents/photos are stored (absolute path on the server,
# OUTSIDE the web root). Defaults to ./uploads next to the app if unset.
UPLOADS_DIR=""

# Initial password for seeded family accounts (prisma/seed.js); users should
# change it after first login.
SEED_PASSWORD="ChangeMe!2026"
